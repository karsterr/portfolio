# Yerel geliştirme: local. Üretim build'i yalnızca github kullanır.
PUBLIC_CMS_STORAGE=local
# Gerçek özel içerik deposunu yazın. Production build sırasında kullanılır.
PUBLIC_CONTENT_REPO=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# Yalnızca admin runtime'ına verilir. Değerleri Git'e eklemeyin.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
# Public build: alan adı seçilene kadar boş bırakın (noindex).
SITE_URL=
# Varsayılan içerik: .local/content. CI için özel checkout'un content dizini.
CONTENT_DIR=
# Docker public sunumu: varsayılan yalnızca bu makine.
WEB_BIND_IP=127.0.0.1
WEB_HTTP_PORT=8080
WEB_HTTPS_PORT=8443
SITE_ADDRESS=:8080
PUBLIC_DIR=./dist/public
