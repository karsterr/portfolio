---
import { settings, text } from '../lib/site';
import type { Locale } from '../../shared/content';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = text[locale];
const profile = settings.profile;
---
<section id="contact" class="contact-section home-section" aria-labelledby="contact-title">
  <div data-reveal>
    <p class="eyebrow">04 / {t.contact}</p>
    <h2 id="contact-title" class="section-title mt-3 max-w-lg">{t.contactTitle}</h2>
    <p class="mt-6 max-w-xl text-lg leading-8 text-muted">{t.contactIntro}</p>
    {profile?.freelanceAvailable && <p class="availability mt-6"><span aria-hidden="true"></span>{t.available}</p>}
  </div>
  <div class="contact-actions" data-reveal>
    {profile && <><a class="button-primary" href={`mailto:${profile.email}`}>{t.emailAction}<span aria-hidden="true">↗</span></a><a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}</a></>}
    <p class="max-w-md text-sm leading-7 text-muted">{t.contactBrief}</p>
    <div class="contact-links">
      {profile?.upworkUrl && <a href={profile.upworkUrl}>{t.upworkAction} <span aria-hidden="true">↗</span></a>}
      {settings.links.map((link) => <a href={link.url}>{link.label} <span aria-hidden="true">↗</span></a>)}
    </div>
  </div>
</section>
