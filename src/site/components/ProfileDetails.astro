---
import { settings, text } from '../lib/site';
import type { Locale } from '../../shared/content';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = text[locale];
const profile = settings.profile;
---
{profile && <div class="profile-details" data-reveal>
  <div class="profile-education">
    <h3 class="eyebrow">{t.education}</h3>
    <p class="mt-3 font-semibold">{profile.education.institution}</p>
    <p class="mt-2 text-sm leading-6 text-muted">{profile.education.degree[locale]}</p>
    <p class="mt-3 font-mono text-xs leading-6 text-muted">{profile.education.period}{profile.education.grade && <> · {t.grade}: {profile.education.grade}</>}</p>
  </div>
  <div class="profile-skills">
    <h3 class="eyebrow">{t.skills}</h3>
    <div class="skill-groups">{profile.skillGroups.map((group) => <div>
      <h4 class="mb-3 text-sm font-semibold">{group.label[locale]}</h4>
      <ul class="flex flex-wrap gap-2" role="list">{group.skills.map((skill) => <li class="tag">{skill}</li>)}</ul>
    </div>)}</div>
  </div>
  <p class="profile-languages text-sm leading-7 text-muted"><span class="font-semibold text-ink">{t.languages}:</span> {profile.languages[locale]}</p>
</div>}
