---
import { Image } from 'astro:assets';
import portrait from '../../assets/profile/efe-can-kara.jpeg';
import { settings, text } from '../lib/site';
import { sections, type Locale } from '../../shared/content';
import ProfileDetails from './ProfileDetails.astro';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = text[locale];
const profile = settings.profile;
---
<section id="about" class="home-section" aria-labelledby="about-title">
  <div data-reveal><p class="eyebrow">01 / {t.about}</p><h2 id="about-title" class="section-title mt-3">{t.hello} {settings.name.split(' ')[0]}.</h2></div>
  <div class="about-grid mt-10">
    <figure class="portrait-frame" data-reveal>
      <Image src={portrait} alt={t.portraitAlt} width={400} height={400} widths={[240, 400]} sizes="(min-width: 768px) 300px, (min-width: 400px) 320px, calc(100vw - 48px)" format="webp" quality={85} loading="lazy" class="portrait" />
      <figcaption class="portrait-caption"><span class="font-semibold">{settings.name}</span><span>{settings.title[locale]}</span>{profile && <span>{profile.location[locale]}</span>}</figcaption>
    </figure>
    <div data-reveal>
      <div class="about-copy">{settings.about[locale].split(/\n\s*\n/).map((paragraph) => <p>{paragraph}</p>)}</div>
      {profile && <aside class="personal-note"><h3 class="eyebrow">{t.personalSide}</h3><p class="mt-3 leading-8 text-muted">{profile.personalNote[locale]}</p></aside>}
      <a href={`/${locale}/${sections[locale].experience}/`} class="mt-8 inline-block text-sm font-semibold text-accent">{t.experienceLink} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <ProfileDetails locale={locale} />
</section>
