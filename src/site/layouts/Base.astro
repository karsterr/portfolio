---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import themeBootstrap from '../scripts/theme-init.js?url';
import AmbientBackground from '../components/AmbientBackground.astro';
import BrandMark from '../../assets/brand/mark.svg';
import BrandWordmark from '../../assets/brand/wordmark.svg';
import { settings, text } from '../lib/site';
import { sections, type Locale } from '../../shared/content';
interface Props { locale: Locale; title: string; description?: string; alternate?: string; canonicalPath?: string; }
const { locale, title, description = settings.intro[locale], alternate, canonicalPath } = Astro.props;
const t = text[locale];
const other = locale === 'tr' ? 'en' : 'tr';
const canonical = Astro.site ? new URL(canonicalPath || Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#111111" />
    <script is:inline src={themeBootstrap}></script>
    <ClientRouter fallback="swap" />
    <meta name="description" content={description} />
    <title>{title} · {settings.name}</title>
    {!canonical && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <link rel="alternate" hreflang={locale} href={canonical} />}
    {canonical && alternate && <link rel="alternate" hreflang={other} href={new URL(alternate, Astro.site)} />}
    {canonical && <link rel="alternate" type="application/rss+xml" title={`${settings.name} — ${t.posts}`} href={`/${locale}/rss.xml`} />}
    <meta property="og:title" content={`${title} · ${settings.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === 'tr' ? 'tr_TR' : 'en_US'} />
    {canonical && <meta property="og:url" content={canonical} />}
    {canonical && <><meta property="og:image" content={new URL('/brand/social.webp', Astro.site)} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="400" /><meta property="og:image:alt" content={`${settings.name} — ${settings.title[locale]}`} /><meta name="twitter:card" content="summary_large_image" /></>}
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/apple-touch-icon.png" />
  </head>
  <body>
    <AmbientBackground />
    <div class="page-intro" aria-hidden="true">
      <div class="intro-content"><BrandWordmark class="intro-wordmark" aria-hidden="true" /><span class="intro-label">{t.loading}</span><span class="intro-line"></span></div>
    </div>
    <div class="reading-progress" aria-hidden="true"><span></span></div>
    <a href="#main" data-astro-reload class="skip-link">{t.skip}</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a href={`/${locale}/`} class="site-brand" aria-label={`${settings.name} — ${t.home}`}>
          <BrandMark class="brand-symbol" aria-hidden="true" />{settings.name}
        </a>
        <nav aria-label={locale === 'tr' ? 'Ana gezinme' : 'Main navigation'} class="site-nav">
          {(['projects', 'posts', 'guides', 'experience'] as const).map((kind) => <a href={`/${locale}/${sections[locale][kind]}/`} aria-current={Astro.url.pathname.includes(`/${sections[locale][kind]}/`) ? 'page' : undefined}>{t[kind]}</a>)}
          <a href={`/${locale}/#contact`}>{t.contact}</a>
        </nav>
        <div class="site-controls">
          <button type="button" class="icon-button theme-toggle" data-theme-toggle data-label-light={t.themeLight} data-label-dark={t.themeDark} aria-label={t.themeLight} title={t.themeLight} hidden>
            <svg class="theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></svg>
            <svg class="theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20.5 13.2A8.5 8.5 0 0 1 10.8 3.5a8.5 8.5 0 1 0 9.7 9.7Z" /></svg>
          </button>
          <button type="button" class="icon-button motion-toggle" data-motion-toggle data-label-pause={t.motionPause} data-label-resume={t.motionResume} data-label-reduced={t.motionReduced} aria-label={t.motionPause} aria-pressed="false" title={t.motionPause} hidden>
            <svg class="motion-pause" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 5v14M16 5v14" /></svg>
            <svg class="motion-play" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m8 5 11 7-11 7Z" /></svg>
          </button>
          <a href={alternate || `/${other}/`} lang={other} hreflang={other} data-locale-switch={other} class="icon-button language-switch" aria-label={t.otherLanguage}>{other.toUpperCase()}</a>
        </div>
      </div>
    </header>
    <main id="main" class="shell min-h-[65vh]" tabindex="-1"><slot /></main>
    <footer class="shell site-footer mt-24 flex flex-wrap items-center justify-between gap-5 border-t border-line py-8 text-sm text-muted">
      <div class="footer-brand"><BrandWordmark class="footer-wordmark" aria-hidden="true" /><p>© {new Date().getUTCFullYear()} {settings.name}</p></div>
      <p class="font-mono text-xs">{t.footer}</p>
      <div class="flex flex-wrap gap-5">{settings.links.map((link) => <a href={link.url} rel="me">{link.label}</a>)}{settings.profile?.upworkUrl && <a href={settings.profile.upworkUrl} rel="me">Upwork</a>}</div>
    </footer>
    <button type="button" class="icon-button scroll-top" data-scroll-top aria-label={t.backToTop} title={t.backToTop} hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 12 6-6 6 6M12 6v14" /></svg></button>
    <script>import '../scripts/site';</script>
  </body>
</html>
